<view class="gal" bindtap="onAdvance">

  <!-- 舞台：立绘（含背景）；缺图降级为渐变场景 -->
  <image wx:if="{{hasSprite}}" class="sprite {{typing ? 'talk' : ''}}" src="{{spriteSrc}}"
    mode="aspectFill" binderror="onSpriteErr" />
  <view wx:else class="stage-fallback">
    <view class="fb-sky"></view>
    <text class="fb-boss {{typing ? 'talk' : ''}}">👩‍💼</text>
  </view>

  <!-- 当前方案面板（道具风，点开进明细） -->
  <view class="plan-panel" wx:if="{{planMsg}}" catchtap="onOpenPlan">
    <view class="pp-head">
      <text class="pp-tag">{{planMsg.plan.usageLabel}}配置</text>
      <text class="pp-total">¥{{planMsg.plan.total}}</text>
    </view>
    <view class="pp-line" wx:for="{{planMsg.keyParts}}" wx:key="id" wx:for-item="kp">{{kp.icon}} {{kp.name}}</view>
    <view class="pp-more">查看完整配置单 →</view>
  </view>

  <!-- 选项肢（galgame 抉择） -->
  <view class="choices" wx:if="{{choices.length && !backlogOpen}}">
    <view class="choice" wx:for="{{choices}}" wx:key="*this" data-t="{{item}}" catchtap="onChoice">{{item}}</view>
  </view>

  <!-- 底部对话框 -->
  <view class="dialog" catchtap="onAdvance">
    <view class="name-tag">{{speaker === '我' ? '我' : '装机宝典 · ' + bossName}}</view>
    <scroll-view class="line-box" scroll-y>
      <text class="line">{{shownText}}</text><text class="adv" wx:if="{{hasMore && !typing}}">▼</text>
      <text class="dots" wx:if="{{waiting}}">……</text>
    </scroll-view>
    <view class="tools">
      <view class="tool" catchtap="onOpenBacklog">📜</view>
      <view class="tool" catchtap="onOpenPanel">👗</view>
      <view class="tool" catchtap="onOpenForm">📋</view>
    </view>
  </view>

  <!-- 常驻输入（对话式确立需求，打字是主要交互） -->
  <view class="input-bar" catchtap="onSwallow">
    <input value="{{input}}" bindinput="onInput" bindconfirm="onSend" confirm-type="send"
      maxlength="300" placeholder="跟{{bossName}}说说：预算多少、拿来干啥…" />
    <button class="send" catchtap="onSend" disabled="{{waiting}}">发送</button>
  </view>

  <!-- 自定义老板娘 -->
  <view class="backlog" wx:if="{{panelOpen}}" catchtap="onClosePanel">
    <view class="bl-panel" catchtap="onSwallow">
      <view class="bl-title">更换店主<text class="bl-close" catchtap="onClosePanel">✕</text></view>
      <scroll-view class="char-list" scroll-y>
        <view class="char-item {{curId === item.id ? 'cur' : ''}}" wx:for="{{presets}}" wx:key="id"
          data-id="{{item.id}}" bindtap="onPickPreset">
          <view class="char-name">{{item.name}}<text class="char-title">{{item.title}}</text>
            <text class="char-lock" wx:if="{{item.locked}}">🔒 看广告解锁</text>
          </view>
          <view class="char-style">{{item.style}}</view>
        </view>
        <view class="char-custom">
          <view class="char-name">✨ 自定义店主{{curId === 'custom' ? '（当前）' : ''}}</view>
          <input class="cc-input" value="{{customName}}" bindinput="onCustomName" maxlength="12" placeholder="名字（如：阿远）" />
          <textarea class="cc-area" value="{{customStyle}}" bindinput="onCustomStyle" maxlength="200"
            placeholder="性格与说话风格（如：冷静寡言的技术宅，只讲干货，偶尔冷幽默）" />
          <view class="cc-row">
            <button class="cc-btn ghost" catchtap="onPickSprite">{{customPicked ? '✓ 已选立绘' : '上传立绘(可选)'}}</button>
            <button class="cc-btn" catchtap="onSaveCustom">启用</button>
          </view>
          <view class="cc-tip">立绘规格见 docs/ART-ASSETS.md；不上传则用默认立绘。人设只影响口吻，报价纪律不变。</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 开屏广告（参考通用小程序开屏样式：右上角倒计时跳过 + 底部品牌标识） -->
  <view class="splash" wx:if="{{splashUnit}}" catchtap="onSwallow">
    <view class="splash-skip" catchtap="onSplashSkip">跳过 {{splashCount}}s</view>
    <view class="splash-ad">
      <ad-custom unit-id="{{splashUnit}}" binderror="onSplashSkip"></ad-custom>
    </view>
    <view class="splash-logo">🖥️ 装机宝典</view>
  </view>

  <!-- 回想（对话记录） -->
  <view class="backlog" wx:if="{{backlogOpen}}" catchtap="onCloseBacklog">
    <view class="bl-panel" catchtap="onSwallow">
      <view class="bl-title">对话记录<text class="bl-close" catchtap="onCloseBacklog">✕</text></view>
      <scroll-view class="bl-list" scroll-y scroll-into-view="{{scrollInto}}">
        <view class="bl-item {{item.role}}" wx:for="{{backlog}}" wx:key="id" id="{{item.id}}">
          <text class="bl-name">{{item.role === 'user' ? '我' : bossName}}</text>
          <text class="bl-text">{{item.content}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

</view>
