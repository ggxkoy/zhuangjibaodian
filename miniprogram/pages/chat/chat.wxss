.gal { position: relative; width: 100vw; height: 100vh; overflow: hidden; background: #1a1d26; }

/* 立绘舞台 */
.sprite { position: absolute; inset: 0; width: 100%; height: 100%; }
.sprite.talk { animation: talk-bob 0.9s ease-in-out infinite; }
@keyframes talk-bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}
.stage-fallback { position: absolute; inset: 0; }
.fb-sky {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, #aecdf5 0%, #d9e8fb 45%, #f5e3d8 100%);
}
.fb-boss {
  position: absolute; left: 50%; bottom: 30%; transform: translateX(-50%);
  font-size: 340rpx; filter: drop-shadow(0 20rpx 40rpx rgba(0,0,0,0.25));
}
.fb-boss.talk { animation: talk-bob 0.9s ease-in-out infinite; }

/* 当前方案面板（道具风） */
.plan-panel {
  position: absolute; top: 24rpx; right: 24rpx; width: 400rpx;
  background: rgba(255, 255, 255, 0.92); border: 3rpx solid #dce7ff;
  border-radius: 22rpx; padding: 20rpx 24rpx;
  box-shadow: 0 10rpx 40rpx rgba(31, 35, 41, 0.25);
}
.pp-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.pp-tag { background: #eaf1ff; color: #2b6fff; font-size: 20rpx; font-weight: 600; padding: 2rpx 14rpx; border-radius: 999rpx; }
.pp-total { font-size: 32rpx; font-weight: 800; color: #1f2329; }
.pp-line { font-size: 21rpx; color: #4e5969; line-height: 1.7; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pp-more { margin-top: 8rpx; font-size: 21rpx; color: #2b6fff; font-weight: 600; }

/* 选项肢 */
.choices {
  position: absolute; left: 50%; bottom: 42%; transform: translateX(-50%);
  display: flex; flex-direction: column; gap: 18rpx; width: 74%;
}
.choice {
  text-align: center; padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 3rpx solid rgba(120, 160, 255, 0.8);
  border-radius: 999rpx; font-size: 28rpx; font-weight: 600; color: #2b4a8f;
  box-shadow: 0 6rpx 24rpx rgba(31, 35, 41, 0.22);
  animation: choice-in 0.25s ease both;
}
.choice:active { background: #eaf1ff; }
@keyframes choice-in { from { opacity: 0; transform: translateY(16rpx); } to { opacity: 1; } }

/* 底部对话框（下方是常驻输入栏） */
.dialog {
  position: absolute; left: 20rpx; right: 20rpx;
  bottom: calc(130rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(250, 252, 255, 0.94), rgba(232, 240, 255, 0.94));
  border: 3rpx solid rgba(150, 180, 255, 0.9);
  border-radius: 26rpx; padding: 40rpx 28rpx 22rpx;
  box-shadow: 0 12rpx 50rpx rgba(10, 20, 50, 0.4);
}
.name-tag {
  position: absolute; top: -26rpx; left: 26rpx;
  background: linear-gradient(135deg, #7ba2ff, #5d7bff);
  color: #fff; font-size: 24rpx; font-weight: 700;
  padding: 8rpx 28rpx; border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(60, 90, 200, 0.45);
}
.line-box { height: 200rpx; }
.line { font-size: 29rpx; line-height: 1.75; color: #2a3550; white-space: pre-wrap; }
.adv { color: #5d7bff; font-size: 26rpx; margin-left: 8rpx; animation: blink 1s infinite; }
.dots { color: #8a97b8; animation: blink 1s infinite; }
@keyframes blink { 50% { opacity: 0.15; } }
.tools { position: absolute; right: 20rpx; top: -64rpx; display: flex; gap: 14rpx; }
.tool {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.9); border: 3rpx solid rgba(150, 180, 255, 0.8);
  display: flex; align-items: center; justify-content: center; font-size: 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(10, 20, 50, 0.25);
}

/* 常驻输入栏 */
.input-bar {
  position: absolute; left: 20rpx; right: 20rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex; gap: 14rpx; align-items: center;
  background: rgba(255, 255, 255, 0.92); border: 3rpx solid rgba(150, 180, 255, 0.7);
  border-radius: 999rpx; padding: 10rpx 12rpx 10rpx 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(10, 20, 50, 0.3);
}
.input-bar input { flex: 1; font-size: 27rpx; }
.send {
  margin: 0; padding: 0 36rpx; border-radius: 999rpx; line-height: 2.5;
  background: linear-gradient(135deg, #ff7eb3, #ff5586); color: #fff;
  font-size: 28rpx; font-weight: 600;
}

/* 回想 */
.backlog {
  position: absolute; inset: 0; background: rgba(10, 15, 30, 0.6);
  display: flex; align-items: center; justify-content: center;
}
.bl-panel {
  width: 86%; max-height: 70%; background: rgba(252, 253, 255, 0.97);
  border-radius: 26rpx; padding: 28rpx; display: flex; flex-direction: column;
}
.bl-title { font-size: 30rpx; font-weight: 700; margin-bottom: 18rpx; }
.bl-close { float: right; color: #86909c; font-size: 30rpx; padding: 0 10rpx; }
.bl-list { flex: 1; min-height: 300rpx; max-height: 56vh; }
.bl-item { margin-bottom: 18rpx; }

/* 自定义老板娘面板 */
.char-list { max-height: 60vh; }
.char-item {
  border: 3rpx solid #e5e6eb; border-radius: 20rpx; padding: 20rpx 24rpx; margin-bottom: 16rpx;
}
.char-item.cur { border-color: #ff5586; background: #fff5f8; }
.char-name { font-size: 29rpx; font-weight: 700; color: #1f2329; }
.char-title { font-size: 21rpx; color: #86909c; font-weight: 400; margin-left: 12rpx; }
.char-lock {
  float: right; font-size: 20rpx; font-weight: 500; color: #b25e00;
  background: #fff7e8; padding: 2rpx 14rpx; border-radius: 999rpx;
}
.char-style { font-size: 23rpx; color: #4e5969; line-height: 1.5; margin-top: 6rpx; }
.char-custom { border-top: 2rpx dashed #eef0f4; padding-top: 20rpx; }
.cc-input, .cc-area {
  width: 100%; box-sizing: border-box; border: 3rpx solid #e5e6eb; border-radius: 16rpx;
  padding: 14rpx 20rpx; font-size: 26rpx; margin-top: 14rpx;
}
.cc-area { height: 120rpx; }
.cc-row { display: flex; gap: 14rpx; margin-top: 16rpx; }
.cc-btn {
  flex: 1; margin: 0; font-size: 26rpx; font-weight: 600; border-radius: 16rpx; line-height: 2.3;
  background: linear-gradient(135deg, #ff7eb3, #ff5586); color: #fff;
}
.cc-btn.ghost { background: #fff; color: #ff5586; border: 3rpx solid #ffb3c8; }
.cc-tip { font-size: 20rpx; color: #b7bdc9; line-height: 1.5; margin-top: 12rpx; }
.bl-name { font-size: 21rpx; color: #5d7bff; font-weight: 700; display: block; }
.bl-item.user .bl-name { color: #b25e00; }
.bl-text { font-size: 26rpx; color: #2a3550; line-height: 1.6; }
