<view class="header">
  <text class="header-icon">🖥️</text>
  <view>
    <view class="header-title">装机宝典</view>
    <view class="header-sub">选择预算和用途，按硬件规则生成整机方案</view>
  </view>
</view>

<view class="rule-info">
  <view class="rule-title">规则计算说明</view>
  <view class="rule-text">输入项仅用于预算和用途筛选。方案由固定硬件数据、接口兼容、功耗与预算规则计算。</view>
</view>

<view class="card">
  <text class="card-title">💰 你的预算</text>
  <view class="budget-wrap">
    <text class="yuan">¥</text>
    <input type="number" value="{{budget}}" bindinput="onBudget" placeholder="请输入预算金额" />
  </view>
  <view class="chips">
    <view class="chip {{budget === item ? 'selected' : ''}}" wx:for="{{chips}}" wx:key="*this"
      data-v="{{item}}" bindtap="onChip">{{item}}</view>
  </view>
</view>

<view class="card">
  <text class="card-title">🎯 主要用途</text>
  <view class="usage-grid">
    <view class="usage-item {{usage === item.key ? 'selected' : ''}}" wx:for="{{usages}}" wx:key="key"
      data-usage="{{item.key}}" bindtap="onUsage">
      <text class="usage-icon">{{item.icon}}</text>
      <text class="usage-name">{{item.name}}</text>
      <text class="usage-desc">{{item.desc}}</text>
    </view>
  </view>
</view>

<view class="err" wx:if="{{errMsg}}">{{errMsg}}</view>
<button class="btn-primary" bindtap="onGenerate" disabled="{{loading}}">{{loading ? '正在生成…' : '生成装机方案'}}</button>
<view class="tip-line">价格实时拉取京东 / 淘宝 / 拼多多，取各平台最低价</view>

<!-- 尾部展示位（未配置 adUnitId 时隐藏） -->
<view class="ad-wrap" wx:if="{{bannerBottomUnit}}">
  <ad unit-id="{{bannerBottomUnit}}"></ad>
</view>
