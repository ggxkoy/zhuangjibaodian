.header { display: flex; align-items: center; gap: 20rpx; padding: 40rpx 32rpx 28rpx; }
.header-icon { font-size: 64rpx; }
.header-title { font-size: 42rpx; font-weight: 700; }
.header-sub { font-size: 24rpx; color: #86909c; margin-top: 4rpx; }

.budget-wrap {
  display: flex; align-items: center; gap: 14rpx;
  border: 3rpx solid #e5e6eb; border-radius: 18rpx; padding: 18rpx 26rpx; margin-bottom: 22rpx;
}
.yuan { font-size: 38rpx; font-weight: 700; color: #2b6fff; }
.budget-wrap input { flex: 1; font-size: 36rpx; font-weight: 600; }

.chips { display: flex; gap: 14rpx; flex-wrap: wrap; }
.chip {
  background: #f2f3f7; color: #86909c; padding: 12rpx 28rpx;
  border-radius: 999rpx; font-size: 26rpx;
}
.chip.selected { background: #eaf1ff; color: #2b6fff; font-weight: 600; }

.usage-grid { display: flex; gap: 18rpx; }
.usage-item {
  flex: 1; border: 3rpx solid #e5e6eb; border-radius: 20rpx;
  padding: 26rpx 8rpx 22rpx; display: flex; flex-direction: column; align-items: center; gap: 6rpx;
}
.usage-item.selected { border-color: #2b6fff; background: #eaf1ff; }
.usage-icon { font-size: 48rpx; }
.usage-name { font-size: 29rpx; font-weight: 600; }
.usage-item.selected .usage-name { color: #2b6fff; }
.usage-desc { font-size: 19rpx; color: #86909c; text-align: center; }

.err { color: #fa5151; font-size: 26rpx; text-align: center; margin-bottom: 16rpx; }
.ad-wrap { margin: 24rpx; border-radius: 20rpx; overflow: hidden; }

.rule-info {
  margin: 0 24rpx 24rpx; padding: 20rpx 24rpx;
  border: 2rpx solid #d9e6ff; border-radius: 16rpx; background: #f5f8ff;
}
.rule-title { color: #2b6fff; font-size: 25rpx; font-weight: 600; margin-bottom: 6rpx; }
.rule-text { color: #4e5969; font-size: 23rpx; line-height: 1.6; }
